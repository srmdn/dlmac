#!/usr/bin/env bash
set -euo pipefail

VERSION="0.3.0"
DOWNLOAD_DIR="downloads"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="${SCRIPT_DIR}/$(basename "${BASH_SOURCE[0]}")"

usage() {
  cat <<EOF
dlmac v${VERSION} — macOS CLI for yt-dlp and ffmpeg

Usage:
  dlmac info <url>                    Show video metadata
  dlmac formats <url>                 Show available formats
  dlmac video <url>                   Download best video (mp4)
  dlmac video <url> --quality 360p    Download best video up to 360p
  dlmac video <url> --quality 480p    Download best video up to 480p
  dlmac video <url> --quality 720p    Download best video up to 720p
  dlmac video <url> --quality 1080p   Download best video up to 1080p
  dlmac audio <url>                   Download best audio (mp3)
  dlmac audio <url> --format mp3      Download audio as mp3
  dlmac audio <url> --format m4a      Download audio as m4a
  dlmac audio <url> --format wav      Download audio as wav
  dlmac transcript <url>              Download transcript as txt (English)
  dlmac transcript <url> --lang id    Download Indonesian transcript
  dlmac transcript <url> --lang en    Download English transcript
  dlmac transcript <url> --format txt Download transcript as plain text
  dlmac transcript <url> --format vtt Download transcript as WebVTT
  dlmac transcript <url> --format srt Download transcript as SRT
  dlmac serve                         Start localhost web UI
  dlmac ui                            Alias for serve
  dlmac convert <file> --to <format> Convert local video, audio, or image media

Requirements: yt-dlp, ffmpeg, webp (install via Homebrew)
Output: ./downloads/
EOF
  exit "${1:-0}"
}

cmd_serve() {
  if [[ $# -gt 0 && ("$1" == "--help" || "$1" == "-h") ]]; then
    echo "Usage: dlmac serve"
    echo "Start the localhost-only web interface."
    exit 0
  fi

  if [[ $# -gt 0 ]]; then
    echo "dlmac: unknown option '$1'"
    echo "Usage: dlmac serve"
    exit 1
  fi

  local web_helper="${SCRIPT_DIR}/dlmac-web"
  local work_dir="$PWD"

  if [[ -x "$web_helper" ]]; then
    exec "$web_helper" --dlmac "$SCRIPT_PATH" --workdir "$work_dir"
  fi

  if [[ -d "${SCRIPT_DIR}/cmd/dlmac-web" ]]; then
    require_cmd go
    cd "$SCRIPT_DIR"
    exec go run ./cmd/dlmac-web --dlmac "$SCRIPT_PATH" --workdir "$work_dir"
  fi

  echo "dlmac: web helper not found next to ${SCRIPT_PATH}"
  echo "Run install.sh to build dlmac-web, then keep both executables together."
  exit 1
}

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" &>/dev/null; then
    echo "dlmac: '$cmd' not found."
    echo "Install with: brew install $cmd"
    exit 1
  fi
}

resolve_webp_tool() {
  local tool="$1"
  local override=""

  case "$tool" in
    cwebp) override="${DLMAC_CWEBP_PATH:-}" ;;
    gif2webp) override="${DLMAC_GIF2WEBP_PATH:-}" ;;
  esac

  if [[ -n "$override" && -x "$override" ]]; then
    printf '%s\n' "$override"
    return 0
  fi

  local bundled="${SCRIPT_DIR}/.dlmac/bin/${tool}"
  if [[ -x "$bundled" ]]; then
    printf '%s\n' "$bundled"
    return 0
  fi

  command -v "$tool" 2>/dev/null
}

require_webp_tool() {
  local tool="$1"
  local tool_path

  if ! tool_path="$(resolve_webp_tool "$tool")"; then
    echo "dlmac: '$tool' not found."
    echo "Install WebP tools with: brew install webp"
    exit 1
  fi

  printf '%s\n' "$tool_path"
}

cmd_info() {
  if [[ $# -eq 0 ]]; then
    echo "dlmac: missing URL"
    echo "Usage: dlmac info <url>"
    exit 1
  fi

  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: dlmac info <url>"
    echo "Show video metadata (title, duration, uploader)."
    exit 0
  fi

  require_cmd yt-dlp
  yt-dlp --print title --print duration --print uploader "$1"
}

cmd_formats() {
  if [[ $# -eq 0 ]]; then
    echo "dlmac: missing URL"
    echo "Usage: dlmac formats <url>"
    exit 1
  fi

  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: dlmac formats <url>"
    echo "Show available download formats."
    exit 0
  fi

  require_cmd yt-dlp
  yt-dlp -F "$1"
}

cmd_video() {
  if [[ $# -eq 0 ]]; then
    echo "dlmac: missing URL"
    echo "Usage: dlmac video <url> [--quality 360p|480p|720p|1080p]"
    exit 1
  fi

  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: dlmac video <url> [--quality 360p|480p|720p|1080p]"
    echo "Download best video+audio merged to mp4 (H.264, QuickTime-compatible)."
    exit 0
  fi

  local url="$1"
  shift

  local quality=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --quality)
        if [[ -z "${2:-}" ]]; then
          echo "dlmac: --quality requires a value"
          echo "Valid values: 360p, 480p, 720p, 1080p"
          exit 1
        fi
        quality="$2"
        shift 2
        ;;
      *)
        echo "dlmac: unknown option '$1'"
        echo "Usage: dlmac video <url> [--quality 360p|480p|720p|1080p]"
        exit 1
        ;;
    esac
  done

  # Build format string preferring H.264+AAC (QuickTime-compatible)
  # Falls back to any format if H.264 unavailable
  local fmt
  if [[ -n "$quality" ]]; then
    local max_height="${quality%p}"
    case "$quality" in
      360p)  max_height=360 ;;
      480p)  max_height=480 ;;
      720p)  max_height=720 ;;
      1080p) max_height=1080 ;;
      *)
        echo "dlmac: unsupported quality '$quality'"
        echo "Valid values: 360p, 480p, 720p, 1080p"
        exit 1
        ;;
    esac
    fmt="bestvideo[vcodec^=avc][height<=${max_height}]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc][height<=${max_height}]+bestaudio/bv*[height<=${max_height}]+ba/b[height<=${max_height}]"
  else
    fmt="bestvideo[vcodec^=avc]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc]+bestaudio/bv*+ba/b"
  fi

  require_cmd yt-dlp
  require_cmd ffmpeg
  require_cmd ffprobe

  mkdir -p "$DOWNLOAD_DIR"

  local output_pattern="${DOWNLOAD_DIR}/%(title)s.%(ext)s"

  # Predict output filename so we can check codec after download
  local predicted_file
  predicted_file=$(yt-dlp --get-filename -f "$fmt" --merge-output-format mp4 -o "$output_pattern" "$url" 2>/dev/null) || true

  yt-dlp \
    -f "$fmt" \
    --merge-output-format mp4 \
    -o "$output_pattern" \
    "$url"

  # QuickTime needs H.264 video + AAC audio. If yt-dlp fell back to
  # incompatible codecs (VP9 video or Opus audio), re-encode with ffmpeg.
  if [[ -n "$predicted_file" && -f "$predicted_file" ]]; then
    local vcodec acodec
    vcodec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$predicted_file" 2>/dev/null || echo "")
    acodec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$predicted_file" 2>/dev/null || echo "")
    if [[ "$vcodec" != "h264" || "$acodec" != "aac" ]]; then
      echo "Re-encoding to H.264+AAC for QuickTime compatibility..."
      local temp="${predicted_file}.recode.mp4"
      if ffmpeg -i "$predicted_file" -c:v libx264 -preset fast -crf 23 -c:a aac -b:a 128k -movflags +faststart -y "$temp" 2>/dev/null; then
        mv "$temp" "$predicted_file"
        echo "Done: $predicted_file"
      else
        echo "dlmac: re-encode failed, removing partial file"
        rm -f "$temp"
        exit 1
      fi
    fi
  fi
}

cmd_audio() {
  if [[ $# -eq 0 ]]; then
    echo "dlmac: missing URL"
    echo "Usage: dlmac audio <url> [--format mp3|m4a|wav]"
    exit 1
  fi

  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: dlmac audio <url> [--format mp3|m4a|wav]"
    echo "Download best audio, default mp3."
    exit 0
  fi

  local url="$1"
  shift

  local audio_format="mp3"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format)
        if [[ -z "${2:-}" ]]; then
          echo "dlmac: --format requires a value"
          echo "Valid values: mp3, m4a, wav"
          exit 1
        fi
        case "$2" in
          mp3|m4a|wav) audio_format="$2" ;;
          *)
            echo "dlmac: unsupported format '$2'"
            echo "Valid values: mp3, m4a, wav"
            exit 1
            ;;
        esac
        shift 2
        ;;
      *)
        echo "dlmac: unknown option '$1'"
        echo "Usage: dlmac audio <url> [--format mp3|m4a|wav]"
        exit 1
        ;;
    esac
  done

  require_cmd yt-dlp
  require_cmd ffmpeg

  mkdir -p "$DOWNLOAD_DIR"

  local yt_args=(
    -f "bestaudio"
    -x
    --audio-format "$audio_format"
    -o "${DOWNLOAD_DIR}/%(title)s.%(ext)s"
  )
  if [[ "$audio_format" == "mp3" ]]; then
    yt_args+=(--audio-quality 0)
  fi

  yt-dlp "${yt_args[@]}" "$url"
}

clean_vtt_to_txt() {
  local input_file="$1"
  local output_file="$2"

  awk '
    /^WEBVTT/ { next }
    /^Kind:/ { next }
    /^Language:/ { next }
    /^[[:space:]]*$/ { next }
    /^[0-9]+$/ { next }
    /-->/ { next }
    {
      line = $0
      gsub(/\r/, "", line)
      gsub(/<[^>]*>/, "", line)
      gsub(/&amp;/, "\\&", line)
      gsub(/&lt;/, "<", line)
      gsub(/&gt;/, ">", line)
      gsub(/&quot;/, "\"", line)
      gsub(/&#39;/, "\047", line)
      if (line != "" && line != previous) {
        print line
        previous = line
      }
    }
  ' "$input_file" > "$output_file"
}

find_transcript_file() {
  local tmp_dir="$1"
  local lang="$2"
  local ext="$3"

  local matches=()
  shopt -s nullglob
  matches=("$tmp_dir"/*."$lang"."$ext")
  shopt -u nullglob

  if [[ ${#matches[@]} -gt 0 ]]; then
    printf '%s\n' "${matches[0]}"
  fi
}

download_transcript_source() {
  local source_kind="$1"
  local tmp_dir="$2"
  local url="$3"
  local lang="$4"
  local output_format="$5"

  local source_ext="vtt"
  local yt_args=(
    --skip-download
    --sub-langs "$lang"
    --sub-format vtt
    -o "${tmp_dir}/%(title)s.%(id)s.%(ext)s"
  )

  case "$source_kind" in
    manual) yt_args+=(--write-subs) ;;
    auto) yt_args+=(--write-auto-subs) ;;
  esac

  if [[ "$output_format" == "srt" ]]; then
    source_ext="srt"
    yt_args+=(--convert-subs srt)
  fi

  local log_file="${tmp_dir}/${source_kind}.log"
  if ! yt-dlp "${yt_args[@]}" "$url" >"$log_file" 2>&1; then
    cat "$log_file" >&2
    return 2
  fi

  find_transcript_file "$tmp_dir" "$lang" "$source_ext"
}

cmd_transcript() {
  if [[ $# -eq 0 ]]; then
    echo "dlmac: missing URL"
    echo "Usage: dlmac transcript <url> [--lang id|en] [--format txt|vtt|srt]"
    exit 1
  fi

  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: dlmac transcript <url> [--lang id|en] [--format txt|vtt|srt]"
    echo "Download public YouTube captions, default English plain text."
    exit 0
  fi

  local url="$1"
  shift

  local lang="en"
  local output_format="txt"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lang)
        if [[ -z "${2:-}" ]]; then
          echo "dlmac: --lang requires a value"
          echo "Valid values: id, en"
          exit 1
        fi
        case "$2" in
          id|en) lang="$2" ;;
          *)
            echo "dlmac: unsupported language '$2'"
            echo "Valid values: id, en"
            exit 1
            ;;
        esac
        shift 2
        ;;
      --format)
        if [[ -z "${2:-}" ]]; then
          echo "dlmac: --format requires a value"
          echo "Valid values: txt, vtt, srt"
          exit 1
        fi
        case "$2" in
          txt|vtt|srt) output_format="$2" ;;
          *)
            echo "dlmac: unsupported format '$2'"
            echo "Valid values: txt, vtt, srt"
            exit 1
            ;;
        esac
        shift 2
        ;;
      *)
        echo "dlmac: unknown option '$1'"
        echo "Usage: dlmac transcript <url> [--lang id|en] [--format txt|vtt|srt]"
        exit 1
        ;;
    esac
  done

  require_cmd yt-dlp
  if [[ "$output_format" == "srt" ]]; then
    require_cmd ffmpeg
  fi

  mkdir -p "$DOWNLOAD_DIR"

  local tmp_dir
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/dlmac-transcript.XXXXXX")"

  local source_file source_kind source_ext
  source_ext="vtt"
  if [[ "$output_format" == "srt" ]]; then
    source_ext="srt"
  fi

  local source_status

  source_kind="manual captions"
  source_status=0
  source_file="$(download_transcript_source manual "$tmp_dir" "$url" "$lang" "$output_format")" || source_status=$?

  if [[ $source_status -gt 1 ]]; then
    rm -rf "$tmp_dir"
    exit 1
  fi

  if [[ -z "$source_file" ]]; then
    source_kind="auto captions"
    source_status=0
    source_file="$(download_transcript_source auto "$tmp_dir" "$url" "$lang" "$output_format")" || source_status=$?
    if [[ $source_status -gt 1 ]]; then
      rm -rf "$tmp_dir"
      exit 1
    fi
  fi

  if [[ -z "$source_file" ]]; then
    rm -rf "$tmp_dir"
    echo "dlmac: no public transcript found for language '$lang'"
    echo "Try another language or check available captions with: yt-dlp --list-subs <url>"
    exit 1
  fi

  local source_name base_name output_file
  source_name="$(basename "$source_file")"
  base_name="${source_name%."$lang"."$source_ext"}"
  output_file="${DOWNLOAD_DIR}/${base_name}.${lang}.${output_format}"

  if [[ -f "$output_file" ]]; then
    rm -rf "$tmp_dir"
    echo "dlmac: output file already exists: $output_file"
    echo "Remove it first or choose another output format."
    exit 1
  fi

  if [[ "$output_format" == "txt" ]]; then
    clean_vtt_to_txt "$source_file" "$output_file"
  else
    mv "$source_file" "$output_file"
  fi

  rm -rf "$tmp_dir"
  echo "Transcript (${source_kind}): $output_file"
}

cmd_convert() {
  local supported_formats="mp4|webm|mkv|mov|mp3|m4a|wav|flac|ogg|opus|jpg|png|gif|tiff|webp"

  if [[ $# -gt 0 && ("$1" == "--help" || "$1" == "-h") ]]; then
    echo "Usage: dlmac convert <file> --to ${supported_formats}"
    echo "Convert one local video, audio, or image file."
    exit 0
  fi

  if [[ $# -lt 2 ]]; then
    echo "dlmac: missing arguments"
    echo "Usage: dlmac convert <file> --to ${supported_formats}"
    exit 1
  fi

  local input_file="$1"
  shift

  local output_format=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to)
        if [[ -z "${2:-}" ]]; then
          echo "dlmac: --to requires a value"
          echo "Valid values: ${supported_formats//|/, }"
          exit 1
        fi
        case "$2" in
          mp4|webm|mkv|mov|mp3|m4a|wav|flac|ogg|opus|jpg|jpeg|png|gif|tiff|webp)
            output_format="$2"
            ;;
          *)
            echo "dlmac: unsupported format '$2'"
            echo "Valid values: ${supported_formats//|/, }"
            exit 1
            ;;
        esac
        shift 2
        ;;
      *)
        echo "dlmac: unknown option '$1'"
        echo "Usage: dlmac convert <file> --to ${supported_formats}"
        exit 1
        ;;
    esac
  done

  if [[ -z "$output_format" ]]; then
    echo "dlmac: missing --to flag"
    echo "Usage: dlmac convert <file> --to ${supported_formats}"
    exit 1
  fi

  if [[ "$output_format" == "jpeg" ]]; then
    output_format="jpg"
  fi

  if [[ ! -f "$input_file" ]]; then
    echo "dlmac: file not found: $input_file"
    exit 1
  fi

  if [[ "$output_format" != "webp" ]]; then
    require_cmd ffmpeg
  fi

  mkdir -p "$DOWNLOAD_DIR"

  local basename
  basename="$(basename "$input_file")"
  basename="${basename%.*}"
  local output_file="${DOWNLOAD_DIR}/${basename}.${output_format}"

  if [[ -f "$output_file" ]]; then
    echo "dlmac: output file already exists: $output_file"
    echo "Remove it first or rename the input file."
    exit 1
  fi

  case "$output_format" in
    mp4)
      ffmpeg -i "$input_file" \
        -map 0:v:0 -map "0:a?" \
        -c:v libx264 -preset fast -crf 23 -pix_fmt yuv420p \
        -c:a aac -b:a 192k -movflags +faststart "$output_file"
      ;;
    webm)
      ffmpeg -i "$input_file" \
        -map 0:v:0 -map "0:a?" \
        -c:v libvpx-vp9 -crf 30 -b:v 0 \
        -c:a libopus -b:a 128k "$output_file"
      ;;
    mkv)
      ffmpeg -i "$input_file" -map 0 -c copy "$output_file"
      ;;
    mov)
      ffmpeg -i "$input_file" \
        -map 0:v:0 -map "0:a?" \
        -c:v libx264 -preset fast -crf 23 -pix_fmt yuv420p \
        -c:a aac -b:a 192k -movflags +faststart "$output_file"
      ;;
    mp3)
      ffmpeg -i "$input_file" -map 0:a:0 -vn -c:a libmp3lame -q:a 2 "$output_file"
      ;;
    m4a)
      ffmpeg -i "$input_file" -map 0:a:0 -vn -c:a aac -b:a 192k "$output_file"
      ;;
    wav)
      ffmpeg -i "$input_file" -map 0:a:0 -vn -c:a pcm_s16le "$output_file"
      ;;
    flac)
      ffmpeg -i "$input_file" -map 0:a:0 -vn -c:a flac "$output_file"
      ;;
    ogg)
      ffmpeg -i "$input_file" -map 0:a:0 -vn -c:a libvorbis -q:a 5 "$output_file"
      ;;
    opus)
      ffmpeg -i "$input_file" -map 0:a:0 -vn -c:a libopus -b:a 128k "$output_file"
      ;;
    jpg)
      ffmpeg -i "$input_file" -map 0:v:0 -frames:v 1 -update 1 -q:v 2 "$output_file"
      ;;
    png)
      ffmpeg -i "$input_file" -map 0:v:0 -frames:v 1 -update 1 "$output_file"
      ;;
    gif)
      case "${input_file##*.}" in
        jpg|jpeg|png|webp|gif|tif|tiff)
          ffmpeg -i "$input_file" -map 0:v:0 -frames:v 1 -update 1 "$output_file"
          ;;
        *)
          ffmpeg -i "$input_file" -map 0:v:0 -vf "fps=12" "$output_file"
          ;;
      esac
      ;;
    tiff)
      ffmpeg -i "$input_file" -map 0:v:0 -frames:v 1 -update 1 "$output_file"
      ;;
    webp)
      local webp_tool
      case "${input_file##*.}" in
        gif|GIF)
          webp_tool="$(require_webp_tool gif2webp)"
          "$webp_tool" -quiet -q 80 -metadata all -mt "$input_file" -o "$output_file"
          ;;
        *)
          webp_tool="$(require_webp_tool cwebp)"
          "$webp_tool" -quiet -q 80 -metadata all -mt "$input_file" -o "$output_file"
          ;;
      esac
      ;;
  esac

  echo "Converted: $output_file"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage 0
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    info)
      cmd_info "$@"
      ;;
    formats)
      cmd_formats "$@"
      ;;
    video)
      cmd_video "$@"
      ;;
    audio)
      cmd_audio "$@"
      ;;
    transcript)
      cmd_transcript "$@"
      ;;
    serve|ui)
      cmd_serve "$@"
      ;;
    convert)
      cmd_convert "$@"
      ;;
    -h|--help)
      usage 0
      ;;
    --version)
      echo "dlmac v${VERSION}"
      exit 0
      ;;
    *)
      echo "dlmac: unknown command '$cmd'"
      usage 1
      ;;
  esac
}

main "$@"
